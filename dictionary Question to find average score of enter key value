if __name__ == '__main__':
    n = int(input())
    student_marks = {}
    for _ in range(n):
        name, *line = input().split()
        scores = list(map(float, line))
        student_marks[name] = scores
    query_name = input()
    mark_list=student_marks[query_name]
    total_score=0
    total_number=0
    for mark in mark_list:
        total_score+=mark
        total_number+=1
    average=total_score/total_number
    print(f"{average:.2f}")
        

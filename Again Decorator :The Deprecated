from functools import wraps
def deprecated(instead_use):
    def actual_decorator(func):
        @wraps(func)
        def wrapper(*args,**kwargs):
            print(f"[Warning]: '{func.__name__}' is outdated and will be removed soon! Please update your code to use '{instead_use}' instead.")
            return func(*args,**kwargs)
        return wrapper
    return actual_decorator
@deprecated(instead_use="Advance filter")

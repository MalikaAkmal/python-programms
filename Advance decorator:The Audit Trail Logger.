import time
from functools import wraps
def audit_loger(func):
    @wraps(func)
    def wrapper(*args,**kwargs):
        timestamp = time.ctime()
        func_name = func.__name__
        result=func(*args,**kwargs)
        with open("writting file", "a") as file:
            file.write(f"[{timestamp}] Executed function: '{func_name}' with inputs: {args}\n")
        return result
    return wrapper
@audit_loger
def check_get(name,amount):
    return name,amount
check_get("malika",900)
check_get("mena",1000)
print("[System]: Logs successfully written to audit_log.txt!")

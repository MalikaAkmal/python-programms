from functools import wraps  # 1. Imported the tool

def checker(pass_key):
    def actual_decorator(func):
        @wraps(func)         # 2. Applied the stamp right here!
        def wrapper(*args, **kwargs):
            user_token = kwargs.get('n') or (args[0] if args else None)
            if user_token == pass_key:
                return func(*args, **kwargs)
            else:
                print("[Unauthorized Access]: Invalid token!")
                return None
        return wrapper
    return actual_decorator


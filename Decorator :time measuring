import time
def record(func):
    def wrapper(*args, **kwargs):
        start_time = time.time()
        result=func()
        end_time = time.time()
        duration = end_time - start_time
        print(f"Time taken to execute: {duration} seconds")
        return result
    return wrapper
@record
def name():
    time.sleep(2)
    print("malika")
name()
    
        
